---
// Comprobador del bono social eléctrico.
//
// Es una ayuda que se pierde mucha gente que tendría derecho, sobre todo porque los
// umbrales no dependen solo de la renta sino de cómo esté formada la casa. La página
// calcula el umbral que le toca a cada unidad de convivencia y lo enseña, para que se
// pueda comprobar; no da un "sí o no" a ciegas.
//
// Las reglas y su procedencia están en src/lib/bono-social.js, verificadas contra el
// texto CONSOLIDADO del RD 897/2017 (el original de 2017 tiene otros umbrales).
import Layout from '../layouts/Layout.astro';
import {
  IPREM_14, DESCUENTOS, BASE, POR_ADULTO_ADICIONAL, POR_MENOR, POR_CIRCUNSTANCIA_ESPECIAL,
  CIRCUNSTANCIAS, LIMITES_ENERGIA, ANIO_DATOS, umbral,
} from '../lib/bono-social.js';

const eur = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const pct = (n: number) => `${(n * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })}%`;

// Tabla de referencia de umbrales para las composiciones más habituales.
const ejemplos = [
  { txt: 'Una persona sola', a: 1, m: 0 },
  { txt: 'Dos adultos', a: 2, m: 0 },
  { txt: 'Dos adultos y un menor', a: 2, m: 1 },
  { txt: 'Dos adultos y dos menores', a: 2, m: 2 },
  { txt: 'Un adulto y un menor', a: 1, m: 1 },
  { txt: 'Tres adultos', a: 3, m: 0 },
].map((e) => ({ ...e, u: umbral(e.a, e.m, false) }));

const title = 'Bono social eléctrico 2026: comprueba si te corresponde';
const description = `Calcula si tienes derecho al bono social de la luz según tu unidad de convivencia y tu renta. Descuento del ${pct(DESCUENTOS.vulnerable)} o del ${pct(DESCUENTOS.severo)} en la factura. Umbrales oficiales del RD 897/2017 con el IPREM de ${ANIO_DATOS}.`;
const rutaCanonica = '/bono-social/';
const siteUrl = (Astro.site ?? new URL('https://mivatio.es')).href.replace(/\/$/, '');

const faqs = [
  {
    q: '¿Cuánto se descuenta con el bono social?',
    a: `Un ${pct(DESCUENTOS.vulnerable)} de la factura para el consumidor vulnerable y un ${pct(DESCUENTOS.severo)} para el vulnerable severo. Son porcentajes extraordinarios: el Real Decreto-ley 7/2026 los prorrogó para todo ${ANIO_DATOS}, con la previsión de ir bajando hacia el régimen permanente (25% y 40%). El descuento se aplica sobre el PVPC, no sobre cualquier tarifa.`,
  },
  {
    q: '¿Qué requisitos hay además de la renta?',
    a: 'Tres, y son eliminatorios: tener contratado el PVPC (la tarifa regulada) con una comercializadora de referencia, que la potencia contratada no pase de 10 kW, y que sea tu vivienda habitual y estés como titular del contrato. Si estás en el mercado libre, primero hay que pasarse al PVPC.',
  },
  {
    q: '¿De dónde salen estos umbrales?',
    a: `Del artículo 3 del Real Decreto 897/2017, en su texto consolidado. El umbral base es 1,5 veces el IPREM de 14 pagas (${eur(IPREM_14)} en ${ANIO_DATOS}), y sube 0,3 por cada adulto más de la casa y 0,5 por cada menor. Si concurre alguna circunstancia especial, sube 1 más.`,
  },
  {
    q: '¿Qué es una "unidad de convivencia"?',
    a: 'Todas las personas que viven en el mismo domicilio unidas por matrimonio o pareja de hecho, o por parentesco hasta el segundo grado (padres, hijos, abuelos, nietos, hermanos), además de las personas en acogimiento o adopción. No es lo mismo que "los que están empadronados": un compañero de piso sin parentesco no cuenta.',
  },
  {
    q: '¿Se descuenta toda la luz que gaste?',
    a: `No. El descuento tiene un tope de consumo anual según el tamaño de la casa, de ${LIMITES_ENERGIA[0].kwh.toLocaleString('es-ES')} a ${LIMITES_ENERGIA[LIMITES_ENERGIA.length - 1].kwh.toLocaleString('es-ES')} kWh al año. Lo que consumas por encima de ese límite se paga al precio normal.`,
  },
  {
    q: '¿Cómo se solicita y cuánto dura?',
    a: 'Se pide a tu comercializadora de referencia (no a cualquiera: solo las de referencia pueden aplicarlo), con el formulario oficial, tu DNI, el certificado de empadronamiento de todos los miembros y el número de contrato. Dura dos años y hay que renovarlo antes de que caduque, o se pierde.',
  },
  {
    q: '¿Este resultado es oficial?',
    a: 'No. Es una orientación calculada con los umbrales publicados. Quien decide es tu comercializadora, que cruza tus datos con Hacienda y la Seguridad Social. Si el cálculo te sale ajustado, merece la pena solicitarlo igualmente: pedirlo no cuesta nada.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Bono social', item: siteUrl + rutaCanonica },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};

const card = 'rounded-2xl border border-[#232733] bg-[#14171F] p-4';
const input = 'mt-1 w-full rounded-lg border border-[#232733] bg-[#0B0D12] px-3 py-2 font-mono text-[#ECEAE3]';
const etiqueta = 'text-xs font-semibold uppercase tracking-wide text-[#5A6070]';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full" style="background-color:#0B0D12;">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-[#5A6070]">
          <a href="/" class="hover:text-[#2DD4BF]">Inicio</a>
          <span class="mx-1.5">/</span>
          <span class="text-[#8A8F9C]">Bono social</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-[#ECEAE3] sm:text-3xl">
            ¿Te corresponde el <span class="text-[#2DD4BF]">bono social</span> de la luz?
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-[#8A8F9C]">
            Es un descuento del <strong class="text-[#ECEAE3]">{pct(DESCUENTOS.vulnerable)}</strong> o del
            {' '}<strong class="text-[#ECEAE3]">{pct(DESCUENTOS.severo)}</strong> en la factura. El límite de
            renta no es el mismo para todos: depende de cuántas personas vivan en casa y de si
            hay menores. Mucha gente que tiene derecho no lo pide porque calcula mal el umbral.
          </p>
          <p class="mt-2 text-xs text-[#5A6070]">Umbrales del RD 897/2017 con el IPREM de {ANIO_DATOS}.</p>
        </header>

        <!-- Comprobador -->
        <section class="px-4 pt-6">
          <div class={card}>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class={etiqueta} for="adultos">Adultos en casa (contándote)</label>
                <input id="adultos" type="number" min="1" max="12" step="1" value="1" class={input} />
              </div>
              <div>
                <label class={etiqueta} for="menores">Menores de edad</label>
                <input id="menores" type="number" min="0" max="12" step="1" value="0" class={input} />
              </div>
            </div>

            <div class="mt-4">
              <label class={etiqueta} for="renta">Renta anual conjunta de toda la casa (€)</label>
              <input id="renta" type="number" min="0" step="500" value="14000" class={input} />
              <p class="mt-1 text-xs text-[#5A6070]">Es la suma de la base imponible del IRPF de todos los miembros.</p>
            </div>

            <div class="mt-4 space-y-2 border-t border-[#232733] pt-4">
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="circunstancia" class="mt-0.5 h-4 w-4 shrink-0 accent-[#2DD4BF]" />
                <span class="text-sm text-[#ECEAE3]">
                  Concurre alguna circunstancia especial
                  <span class="block text-xs text-[#5A6070]">Sube el umbral en 1 vez el IPREM. Ver cuáles debajo.</span>
                </span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="numerosa" class="mt-0.5 h-4 w-4 shrink-0 accent-[#2DD4BF]" />
                <span class="text-sm text-[#ECEAE3]">
                  Tenemos título de familia numerosa
                  <span class="block text-xs text-[#5A6070]">Da acceso sin límite de renta.</span>
                </span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="pension" class="mt-0.5 h-4 w-4 shrink-0 accent-[#2DD4BF]" />
                <span class="text-sm text-[#ECEAE3]">
                  Todos los que cobran son pensionistas de cuantía mínima
                  <span class="block text-xs text-[#5A6070]">Jubilación o incapacidad permanente, sin otros ingresos por encima de 500 €/año.</span>
                </span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="imv" class="mt-0.5 h-4 w-4 shrink-0 accent-[#2DD4BF]" />
                <span class="text-sm text-[#ECEAE3]">
                  Alguien de la casa cobra el Ingreso Mínimo Vital
                  <span class="block text-xs text-[#5A6070]">Da acceso por sí solo.</span>
                </span>
              </label>
            </div>
          </div>
        </section>

        <!-- Resultado -->
        <section class="px-4 pt-4">
          <div class="rounded-2xl border p-5" data-out="caja" style="border-color:#232733;background-color:#14171F;">
            <p class={etiqueta} data-out="titulo">Resultado</p>
            <p class="mt-1 text-2xl font-bold" data-out="nivel">—</p>
            <p class="mt-2 text-sm leading-relaxed text-[#8A8F9C]" data-out="explicacion">—</p>
            <div class="mt-3 border-t border-[#232733] pt-3">
              <p class="text-xs text-[#5A6070]">
                Umbral que corresponde a esta casa: <strong class="text-[#ECEAE3]" data-out="umbral">—</strong>
                {' '}(<span data-out="mult">—</span> veces el IPREM). Para el nivel severo:
                {' '}<strong class="text-[#ECEAE3]" data-out="umbralsevero">—</strong>.
              </p>
            </div>
          </div>
          <p class="mt-2 text-xs leading-relaxed text-[#5A6070]">
            Esto es una orientación, no una resolución. Quien decide es tu comercializadora de
            referencia, que cruza los datos con Hacienda y la Seguridad Social. Si te sale
            ajustado, solicítalo igual: pedirlo no cuesta nada.
          </p>
        </section>

        <!-- Requisitos eliminatorios -->
        <section class="px-4 pt-8">
          <div class="rounded-2xl border p-4" style="border-color:#3A3320;background-color:#1A170E;">
            <p class="text-sm font-semibold" style="color:#F5B83D;">Además de la renta, estos tres son obligatorios</p>
            <ul class="mt-2 space-y-1.5 text-sm text-[#8A8F9C]">
              <li>· Tener contratado el <strong class="text-[#ECEAE3]">PVPC</strong> con una comercializadora de referencia. Si estás en el mercado libre, hay que cambiarse antes.</li>
              <li>· Potencia contratada de <strong class="text-[#ECEAE3]">10 kW o menos</strong>.</li>
              <li>· Que sea tu <strong class="text-[#ECEAE3]">vivienda habitual</strong> y que el contrato esté a tu nombre.</li>
            </ul>
            <a href="/calculadora-potencia/" class="mt-3 inline-block text-xs font-semibold text-[#2DD4BF] hover:underline">Comprobar mi potencia contratada →</a>
          </div>
        </section>

        <!-- Circunstancias especiales -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Qué cuenta como circunstancia especial</h2>
          <p class="mt-1 text-sm text-[#8A8F9C]">Cualquiera de estas sube el umbral en una vez el IPREM ({eur(IPREM_14)} más).</p>
          <ul class="mt-3 space-y-1.5 rounded-2xl border border-[#232733] bg-[#14171F] p-4 text-sm text-[#8A8F9C]">
            {CIRCUNSTANCIAS.map((c) => <li>· {c}</li>)}
          </ul>
        </section>

        <!-- Tabla de umbrales -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Umbrales según quién viva en casa</h2>
          <p class="mt-1 text-sm text-[#8A8F9C]">Sin circunstancias especiales. Con alguna, súmale {eur(IPREM_14)}.</p>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            <table class="w-full text-left text-sm">
              <thead class="text-xs uppercase tracking-wide text-[#5A6070]">
                <tr class="border-b border-[#232733]">
                  <th class="px-4 py-2 font-medium">Unidad de convivencia</th>
                  <th class="px-4 py-2 text-right font-medium">Vulnerable</th>
                  <th class="px-4 py-2 text-right font-medium">Severo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#232733]">
                {ejemplos.map((e) => (
                  <tr>
                    <td class="px-4 py-2 text-[#ECEAE3]">{e.txt}</td>
                    <td class="px-4 py-2 text-right font-mono text-[#8A8F9C]">{eur(e.u.euros)}</td>
                    <td class="px-4 py-2 text-right font-mono text-[#8A8F9C]">{eur(e.u.euros * 0.5)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-2 text-xs text-[#5A6070]">
            Base de {BASE} veces el IPREM, más {POR_ADULTO_ADICIONAL} por cada adulto adicional y
            {' '}{POR_MENOR} por cada menor. Con circunstancia especial, {POR_CIRCUNSTANCIA_ESPECIAL} más.
          </p>
        </section>

        <!-- Límite de energía -->
        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Hasta cuánta luz llega el descuento</h2>
          <p class="mt-1 text-sm text-[#8A8F9C]">Lo que consumas por encima del límite se paga al precio normal.</p>
          <div class="mt-3 overflow-hidden rounded-2xl border border-[#232733] bg-[#14171F]">
            {LIMITES_ENERGIA.map((l) => (
              <div class="flex items-start justify-between gap-3 border-b border-[#232733] px-4 py-2.5 last:border-0">
                <p class="text-sm text-[#8A8F9C]">{l.quien}</p>
                <p class="shrink-0 font-mono text-sm font-bold text-[#ECEAE3]">{l.kwh.toLocaleString('es-ES')} kWh</p>
              </div>
            ))}
          </div>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-[#ECEAE3]">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-[#232733]">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-[#ECEAE3]">
                  <span>{f.q}</span>
                  <span class="text-[#2DD4BF] transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-[#8A8F9C]">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-[#5A6070]">
            Umbrales del artículo 3 del Real Decreto 897/2017, de 6 de octubre, en su texto
            consolidado, con el IPREM de 14 pagas de {ANIO_DATOS} ({eur(IPREM_14)}). Porcentajes de
            descuento prorrogados por el Real Decreto-ley 7/2026, de 20 de marzo. Página
            informativa: no tramitamos el bono social ni podemos resolver tu solicitud, que se
            presenta ante tu comercializadora de referencia.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-[#8A8F9C] hover:text-[#2DD4BF]">Inicio</a>
            <a href="/calculadora-potencia/" class="text-[#8A8F9C] hover:text-[#2DD4BF]">Potencia</a>
            <a href="/aviso-legal" class="text-[#8A8F9C] hover:text-[#2DD4BF]">Aviso legal</a>
            <a href="/privacidad" class="text-[#8A8F9C] hover:text-[#2DD4BF]">Privacidad</a>
          </div>
          <p class="mt-3 text-xs text-[#5A6070]">© {new Date().getFullYear()} Vatio</p>
        </footer>
      </main>
    </div>
  </div>

  <script
    type="application/json"
    id="datos-bono"
    set:html={JSON.stringify({ iprem: IPREM_14, base: BASE, porAdulto: POR_ADULTO_ADICIONAL, porMenor: POR_MENOR, porCircunstancia: POR_CIRCUNSTANCIA_ESPECIAL, desc: DESCUENTOS })}
  />

  <script>
    const crudo = document.getElementById('datos-bono')?.textContent;
    if (crudo) {
      const cfg = JSON.parse(crudo) as {
        iprem: number; base: number; porAdulto: number; porMenor: number;
        porCircunstancia: number; desc: { vulnerable: number; severo: number };
      };
      const eur = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
      const pct = (n: number) => `${(n * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })}%`;
      const el = (id: string) => document.getElementById(id) as HTMLInputElement;
      const out = (n: string) => document.querySelector(`[data-out="${n}"]`) as HTMLElement;

      const campos = ['adultos', 'menores', 'renta', 'circunstancia', 'numerosa', 'pension', 'imv'];

      function calcular() {
        const adultos = Math.max(1, parseInt(el('adultos').value) || 1);
        const menores = Math.max(0, parseInt(el('menores').value) || 0);
        const renta = Math.max(0, parseFloat(String(el('renta').value).replace(',', '.')) || 0);
        const circ = el('circunstancia').checked;
        const numerosa = el('numerosa').checked;
        const pension = el('pension').checked;
        const imv = el('imv').checked;

        let mult = cfg.base + (adultos - 1) * cfg.porAdulto + menores * cfg.porMenor;
        if (circ) mult += cfg.porCircunstancia;
        const umbralEuros = mult * cfg.iprem;

        out('umbral').textContent = eur(umbralEuros);
        out('mult').textContent = mult.toLocaleString('es-ES', { maximumFractionDigits: 1 });
        out('umbralsevero').textContent = eur(umbralEuros * 0.5);

        let nivel: 'severo' | 'vulnerable' | 'no';
        let texto: string;

        if (numerosa) {
          nivel = renta <= 2 * cfg.iprem ? 'severo' : 'vulnerable';
          texto = nivel === 'severo'
            ? `El título de familia numerosa da acceso sin límite de renta, y al no superar dos veces el IPREM (${eur(2 * cfg.iprem)}) entra además como vulnerable severo.`
            : 'El título de familia numerosa da acceso al bono social sin límite de renta.';
        } else if (pension) {
          nivel = renta <= cfg.iprem ? 'severo' : 'vulnerable';
          texto = nivel === 'severo'
            ? `Como pensionistas de cuantía mínima con renta que no supera una vez el IPREM (${eur(cfg.iprem)}), entra como vulnerable severo.`
            : 'Cobrando la cuantía mínima de jubilación o incapacidad permanente se accede como consumidor vulnerable.';
        } else if (imv) {
          nivel = renta <= umbralEuros * 0.5 ? 'severo' : 'vulnerable';
          texto = 'Cobrar el Ingreso Mínimo Vital da acceso al bono social por sí solo.';
        } else if (renta <= umbralEuros * 0.5) {
          nivel = 'severo';
          texto = `La renta no llega a la mitad del umbral de esta casa (${eur(umbralEuros * 0.5)}), así que entra como vulnerable severo.`;
        } else if (renta <= umbralEuros) {
          nivel = 'vulnerable';
          texto = `La renta no supera el umbral de esta casa (${eur(umbralEuros)}), así que entra como consumidor vulnerable.`;
        } else {
          nivel = 'no';
          texto = `La renta supera el umbral de esta casa (${eur(umbralEuros)}) por ${eur(renta - umbralEuros)}. Aun así, mira las otras vías: familia numerosa, pensión mínima o Ingreso Mínimo Vital dan acceso por sí solas, sin mirar la renta.`;
        }

        const caja = out('caja');
        const nivelEl = out('nivel');
        if (nivel === 'severo') {
          nivelEl.textContent = `Sí, como vulnerable severo · ${pct(cfg.desc.severo)} de descuento`;
          nivelEl.style.color = '#2DD4BF';
          caja.style.borderColor = '#2DD4BF66';
        } else if (nivel === 'vulnerable') {
          nivelEl.textContent = `Sí, como vulnerable · ${pct(cfg.desc.vulnerable)} de descuento`;
          nivelEl.style.color = '#2DD4BF';
          caja.style.borderColor = '#2DD4BF66';
        } else {
          nivelEl.textContent = 'Por renta, no sale';
          nivelEl.style.color = '#F5B83D';
          caja.style.borderColor = '#232733';
        }
        out('explicacion').textContent = texto;
      }

      for (const id of campos) {
        const e = el(id);
        e?.addEventListener('input', calcular);
        e?.addEventListener('change', calcular);
      }
      calcular();
    }
  </script>
</Layout>
