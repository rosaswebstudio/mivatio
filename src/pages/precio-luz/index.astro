---
// Índice del archivo histórico: /precio-luz/
//
// Es la puerta de entrada a los años y los meses, y a la vez la página que responde a
// "cuánto ha costado la luz estos años". Lleva los récords de toda la serie, que es lo que
// no puede tener ninguna página de mes suelta.
import Layout from '../../layouts/Layout.astro';
import GraficaLinea from '../../components/GraficaLinea.astro';
import archivo from '../../data/mensual.json';
import {
  listaMeses, listaAnios, serieMensual, cent, eur, hh, MESES,
} from '../../lib/mensual.js';

const meses = listaMeses(archivo);
const anios = listaAnios(meses);
const serie = serieMensual(meses);

const masBarato = meses.reduce((x, m) => (m.media < x.media ? m : x), meses[0]);
const masCaro = meses.reduce((x, m) => (m.media > x.media ? m : x), meses[0]);
const minAbs = meses.reduce((x, m) => (m.min.v < x.min.v ? m : x), meses[0]);
const maxAbs = meses.reduce((x, m) => (m.max.v > x.max.v ? m : x), meses[0]);

const primero = meses[0];
const ultimo = meses[meses.length - 1];
const mediaGlobal = meses.reduce((s, m) => s + m.media * m.n, 0) / meses.reduce((s, m) => s + m.n, 0);

const fechaDe = (anio: number, mes: number, dia: number) =>
  new Date(Date.UTC(anio, mes - 1, dia)).toLocaleDateString('es-ES', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

// Años del más reciente al más antiguo: lo que se busca casi siempre es lo último.
const aniosDesc = [...anios].reverse();

const totalDias = meses.reduce((s, m) => s + m.n, 0);

const title = 'Histórico del precio de la luz en España, mes a mes desde 2021';
const description = `Precio de la luz mes a mes y año a año desde junio de 2021, con datos del PVPC de Red Eléctrica. Media de cada mes, récords de la serie y la hora más barata de cada periodo. ${meses.length} meses y ${totalDias} días de datos.`;
const rutaCanonica = '/precio-luz/';
const siteUrl = (Astro.site ?? new URL('https://mivatio.es')).href.replace(/\/$/, '');

const faqs = [
  {
    q: '¿Cuál ha sido el mes más caro de la luz?',
    a: `El mes más caro de la serie fue ${masCaro.nombre}, con una media de ${cent(masCaro.media)} céntimos por kWh. El más barato ha sido ${masBarato.nombre}, con ${cent(masBarato.media)}. Entre uno y otro hay una diferencia de ${((masCaro.media / masBarato.media - 1) * 100).toLocaleString('es-ES', { maximumFractionDigits: 0 })} %.`,
  },
  {
    q: '¿Cuál es el precio más alto y más bajo que ha llegado a marcar?',
    a: `La hora más cara registrada fue el ${fechaDe(maxAbs.anio, maxAbs.mes, maxAbs.max.d)} a las ${hh(maxAbs.max.h)}, a ${eur(maxAbs.max.v)} €/kWh. La más barata, el ${fechaDe(minAbs.anio, minAbs.mes, minAbs.min.d)} a las ${hh(minAbs.min.h)}, a ${eur(minAbs.min.v)} €/kWh.`,
  },
  {
    q: '¿Por qué el archivo empieza en junio de 2021?',
    a: 'Porque el 1 de junio de 2021 entró en vigor la tarifa 2.0TD, la que sigue vigente, con sus tramos valle, llano y punta. Hasta ese día el PVPC se publicaba con los peajes antiguos (general, nocturno y coche eléctrico), que no son comparables con los de ahora.',
  },
  {
    q: '¿De dónde salen estos precios?',
    a: 'Del fichero oficial del PVPC que publica Red Eléctrica de España cada día. Son precios base por hora para Península, Canarias y Baleares, sin impuesto eléctrico, sin IVA y sin el término fijo de la potencia contratada.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Histórico del precio de la luz', item: siteUrl + rutaCanonica },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full" style="background-color:var(--color-fondo);">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-tenue">
          <a href="/" class="hover:text-acento">Inicio</a>
          <span class="mx-1.5">/</span>
          <span class="text-suave">Histórico</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-tinta sm:text-3xl">
            Histórico del <span class="text-acento">precio de la luz</span>
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-suave">
            Qué ha costado la luz cada mes desde que existe la tarifa actual, con los datos del PVPC
            de Red Eléctrica: <strong class="font-semibold text-tinta">{meses.length} meses</strong> y
            {' '}{totalDias.toLocaleString('es-ES')} días, de {primero.nombre} a {ultimo.nombre}.
            La media de todo el periodo es de {cent(mediaGlobal)} céntimos el kWh.
          </p>
          <p class="mt-2 text-xs text-tenue">Península, Canarias y Baleares. Precio base sin impuestos.</p>
        </header>

        <section class="grid grid-cols-2 gap-3 px-4 pt-5">
          <a href={masBarato.ruta} class="rounded-2xl border border-borde bg-superficie p-4 transition-colors hover:border-acento/50">
            <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Mes más barato</p>
            <p class="mt-1 text-xl font-bold text-barato">{cent(masBarato.media)} <span class="text-sm font-semibold text-tenue">cent</span></p>
            <p class="text-xs capitalize text-tenue">{masBarato.nombre}</p>
          </a>
          <a href={masCaro.ruta} class="rounded-2xl border border-borde bg-superficie p-4 transition-colors hover:border-acento/50">
            <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Mes más caro</p>
            <p class="mt-1 text-xl font-bold text-caro">{cent(masCaro.media)} <span class="text-sm font-semibold text-tenue">cent</span></p>
            <p class="text-xs capitalize text-tenue">{masCaro.nombre}</p>
          </a>
        </section>

        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-tinta">Toda la serie, mes a mes</h2>
          <div class="mt-3 rounded-2xl border border-borde bg-superficie p-4">
            <GraficaLinea id="serie-completa" serie={serie} unidad="cent/kWh" colorMinEsBueno={true} />
          </div>
        </section>

        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-tinta">Récords de la serie</h2>
          <div class="mt-3 overflow-hidden rounded-2xl border border-borde bg-superficie">
            <div class="border-b border-borde px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Hora más cara registrada</p>
              <p class="mt-1 mono text-lg font-bold text-caro">{eur(maxAbs.max.v)} €/kWh</p>
              <p class="text-xs text-suave">{fechaDe(maxAbs.anio, maxAbs.mes, maxAbs.max.d)}, a las {hh(maxAbs.max.h)}</p>
            </div>
            <div class="px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Hora más barata registrada</p>
              <p class="mt-1 mono text-lg font-bold text-barato">{eur(minAbs.min.v)} €/kWh</p>
              <p class="text-xs text-suave">{fechaDe(minAbs.anio, minAbs.mes, minAbs.min.d)}, a las {hh(minAbs.min.h)}</p>
            </div>
          </div>
        </section>

        <section class="px-4 pt-6">
          <h2 class="text-base font-bold text-tinta">Por años</h2>
          <div class="mt-3 space-y-3">
            {aniosDesc.map((a) => (
              <div class="overflow-hidden rounded-2xl border border-borde bg-superficie">
                <a href={a.ruta} class="flex items-baseline justify-between gap-3 border-b border-borde px-4 py-3 transition-colors hover:bg-elevado">
                  <div>
                    <p class="text-base font-bold text-tinta">{a.anio}</p>
                    <p class="text-xs text-tenue">
                      media de {cent(a.media)} cent · {a.meses.length} {a.meses.length === 1 ? 'mes' : 'meses'}
                      {!a.completo && ' (incompleto)'}
                    </p>
                  </div>
                  <span class="shrink-0 text-xs font-semibold text-acento">Ver el año</span>
                </a>
                <div class="flex flex-wrap gap-1.5 px-4 py-3">
                  {MESES.map((nombre, i) => {
                    const m = a.meses.find((x) => x.mes === i + 1);
                    if (!m) {
                      return <span class="rounded-full border border-borde px-2.5 py-1 text-xs capitalize text-tenue opacity-40">{nombre.slice(0, 3)}</span>;
                    }
                    return (
                      <a href={m.ruta}
                        title={`${m.nombre}: ${cent(m.media)} céntimos por kWh`}
                        class="rounded-full border border-borde px-2.5 py-1 text-xs font-medium capitalize text-suave transition-colors hover:border-acento/50 hover:text-acento">
                        {nombre.slice(0, 3)} <span class="mono text-tenue">{cent(m.media, 1)}</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="px-4 pt-6">
          <a href="/precio-medio-mensual/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento/50">
            <div>
              <p class="text-sm font-semibold text-tinta">¿En qué mes del año sale más cara la luz?</p>
              <p class="text-xs text-suave">El mismo mes comparado entre años, para ver la estacionalidad</p>
            </div>
            <span class="shrink-0 rounded-full bg-acento px-3 py-1.5 text-xs font-semibold text-sobre-acento">Ver</span>
          </a>
        </section>

        <section class="px-4 pt-3">
          <a href="/" class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento/50">
            <div>
              <p class="text-sm font-semibold text-tinta">El precio de la luz de hoy, hora a hora</p>
              <p class="text-xs text-suave">En directo, con la hora más barata de lo que queda de día</p>
            </div>
            <span class="shrink-0 rounded-full bg-acento px-3 py-1.5 text-xs font-semibold text-sobre-acento">Abrir</span>
          </a>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Datos del PVPC horario publicado por Red Eléctrica de España para Península, Canarias y
            Baleares, sin impuestos. Página informativa, sin valor contractual.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-suave hover:text-acento">Inicio</a>
            <a href="/horas-baratas-hoy/" class="text-suave hover:text-acento">Horas baratas</a>
            <a href="/precio-medio-mensual/" class="text-suave hover:text-acento">Estacionalidad</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
          </div>
          <p class="mt-3 text-xs text-tenue">© {new Date().getFullYear()} Vatio</p>
        </footer>
      </main>
    </div>
  </div>
</Layout>
