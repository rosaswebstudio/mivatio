---
// Precio de la luz de MAÑANA, escrito en el HTML durante el build.
//
// Es la página con más intención recurrente del nicho: Red Eléctrica publica los precios
// del día siguiente a partir de las 20:15 y la gente entra a esa misma hora todos los
// días. Por eso el sitio se reconstruye también por la tarde (ver el workflow): un build
// de la mañana no puede tener estos datos, sencillamente aún no existen.
import Layout from '../layouts/Layout.astro';
import TablaHoras from '../components/TablaHoras.astro';
import {
  cargarPrecios,
  cargarPreciosOpcional,
  fechaMadrid,
  diaSiguiente,
  fechaLarga,
  resumenDia,
  franjas,
  horasMasBaratas,
} from '../lib/datos-build.js';

const hoy = fechaMadrid();
const manana = diaSiguiente(hoy);

const datosManana = await cargarPreciosOpcional(manana);
const datosHoy = await cargarPrecios(hoy);

const resHoy = resumenDia(datosHoy.horas);
const res = datosManana ? resumenDia(datosManana.horas) : null;
const baratas = datosManana ? horasMasBaratas(datosManana.horas, 3) : [];
const lavadora = datosManana ? franjas(datosManana.horas, 2).mejor : null;

const p5 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 5, maximumFractionDigits: 5 });
const p4 = (v: number) => v.toLocaleString('es-ES', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
const hh = (h: number) => `${String(h).padStart(2, '0')}:00`;
const tramo = (a: number, b: number) => `${hh(a)} a ${hh((b + 1) % 24)}`;

// Variación de la media de mañana respecto a la de hoy.
const variacion = res ? (res.media - resHoy.media) / resHoy.media : 0;
const sube = variacion > 0.01;
const baja = variacion < -0.01;
const pctVar = Math.abs(variacion * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 });

const title = res
  ? `Precio de la luz mañana, ${fechaLarga(manana)} | Vatio`
  : 'Precio de la luz mañana, hora a hora | Vatio';
const description = res
  ? `El precio de la luz mañana ${fechaLarga(manana)}: media de ${p4(res.media)} €/kWh, la hora más barata a las ${hh(res.horaMin)} (${p5(res.min)} €/kWh) y la más cara a las ${hh(res.horaMax)}. Datos oficiales de Red Eléctrica.`
  : 'Consulta el precio de la luz de mañana hora a hora. Red Eléctrica los publica cada tarde a partir de las 20:15h y aquí aparecen en cuanto están disponibles.';

const siteUrl = (Astro.site ?? new URL('https://mivatio.es')).href.replace(/\/$/, '');
const rutaCanonica = '/precio-luz-manana/';

const faqs = [
  {
    q: '¿A qué hora se sabe el precio de la luz de mañana?',
    a: 'Red Eléctrica publica los precios del día siguiente cada tarde, a partir de las 20:15h aproximadamente. Antes de esa hora todavía no existen: el mercado mayorista que los fija no ha cerrado. Esta página se actualiza cada tarde en cuanto se publican.',
  },
  {
    q: '¿Por qué cambia tanto el precio de una hora a otra?',
    a: 'Porque el PVPC sigue el precio del mercado mayorista hora a hora, y ese precio depende de qué tecnología cubre la demanda en cada momento. Cuando hay mucho viento o mucho sol, la electricidad sale barata; en las horas punta de la tarde, cuando hay que encender centrales de gas, se dispara.',
  },
  res && {
    q: `¿A qué hora será más barata la luz mañana?`,
    a: `Mañana ${fechaLarga(manana)} la hora más barata será de ${tramo(res.horaMin, res.horaMin)}, a ${p5(res.min)} €/kWh. La más cara será de ${tramo(res.horaMax, res.horaMax)}, a ${p5(res.max)} €/kWh. Entre las dos hay una diferencia de ${((res.max / res.min - 1) * 100).toLocaleString('es-ES', { maximumFractionDigits: 0 })}%.`,
  },
  {
    q: '¿Estos precios llevan impuestos?',
    a: 'No. Es el precio base del PVPC, sin el impuesto eléctrico ni el IVA, que es como lo publica Red Eléctrica. En la calculadora de la portada puedes activarlos para ver el coste final aproximado.',
  },
  {
    q: '¿Sirve para mí si no tengo la tarifa regulada?',
    a: 'Como referencia sí, pero tu factura no cambiará hora a hora si tienes un precio fijo con una comercializadora del mercado libre. El PVPC es la tarifa regulada y es la referencia con la que se comparan todas las demás ofertas.',
  },
].filter(Boolean) as { q: string; a: string }[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Precio de la luz mañana', item: siteUrl + rutaCanonica },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};

const card = 'rounded-2xl border border-borde bg-superficie p-4';
---
<Layout title={title} description={description} canonicalPath={rutaCanonica}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="min-h-screen w-full bg-fondo">
    <div class="mx-auto flex max-w-5xl justify-center gap-8">
      <main class="w-full max-w-2xl">
        <nav aria-label="Migas de pan" class="px-4 pt-6 text-xs text-tenue">
          <a href="/" class="hover:text-acento">Inicio</a>
          <span class="mx-1.5">/</span>
          <span class="text-suave">Precio de la luz mañana</span>
        </nav>

        <header class="px-4 pt-4">
          <h1 class="text-2xl font-bold tracking-tight text-tinta sm:text-3xl">
            Precio de la luz <span class="text-acento">mañana</span>, hora a hora
          </h1>
          {res ? (
            <>
              <p class="mt-3 text-sm leading-relaxed text-suave">
                Precios de <strong class="text-tinta">{fechaLarga(manana)}</strong>, ya publicados
                por Red Eléctrica. La media del día será de
                {' '}<strong class="text-tinta">{p4(res.media)} €/kWh</strong>, con la hora más
                barata de <strong class="text-barato">{tramo(res.horaMin, res.horaMin)}</strong> a
                {' '}{p5(res.min)} €/kWh.
              </p>
              <p class="mt-2 text-xs text-tenue">
                Precio del PVPC sin impuestos · datos oficiales de Red Eléctrica (REE)
              </p>
            </>
          ) : (
            <p class="mt-3 text-sm leading-relaxed text-suave">
              Los precios de mañana todavía no están publicados. Red Eléctrica los saca cada tarde
              a partir de las <strong class="text-tinta">20:15h</strong>, cuando cierra el mercado
              mayorista que los fija. En cuanto se publiquen aparecen aquí, y mientras tanto abajo
              tienes los de hoy como referencia.
            </p>
          )}
        </header>

        {res ? (
          <>
            <!-- Cifras clave -->
            <section class="grid grid-cols-2 gap-3 px-4 pt-5">
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Media de mañana</p>
                <p class="mono mt-1 text-xl font-bold text-tinta">{p4(res.media)}</p>
                <p class="text-xs text-tenue">€/kWh</p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Frente a hoy</p>
                <p class={`mono mt-1 text-xl font-bold ${sube ? 'text-caro' : baja ? 'text-barato' : 'text-tinta'}`}>
                  {sube ? '+' : baja ? '-' : ''}{pctVar}%
                </p>
                <p class="text-xs text-tenue">hoy: {p4(resHoy.media)} €/kWh</p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Hora más barata</p>
                <p class="mono mt-1 text-xl font-bold text-barato">{hh(res.horaMin)}</p>
                <p class="text-xs text-tenue">{p5(res.min)} €/kWh</p>
              </div>
              <div class={card}>
                <p class="text-xs font-semibold uppercase tracking-wide text-tenue">Hora más cara</p>
                <p class="mono mt-1 text-xl font-bold text-caro">{hh(res.horaMax)}</p>
                <p class="text-xs text-tenue">{p5(res.max)} €/kWh</p>
              </div>
            </section>

            <!-- Qué hacer con esto -->
            {lavadora && (
              <section class="px-4 pt-5">
                <div class="rounded-2xl border border-aviso-borde bg-aviso p-4">
                  <p class="text-sm font-semibold text-acento">Cuándo poner la lavadora mañana</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-suave">
                    El bloque de dos horas seguidas más barato de mañana va de
                    {' '}<strong class="text-tinta">{tramo(lavadora.inicio, lavadora.fin)}</strong>,
                    a una media de {p5(lavadora.media)} €/kWh. Ponerla ahí en vez de en la hora más
                    cara del día ahorra un
                    {' '}{((res.max / lavadora.media - 1) * 100).toLocaleString('es-ES', { maximumFractionDigits: 0 })}%
                    en esa colada.
                  </p>
                </div>
              </section>
            )}

            <!-- Tabla -->
            <section class="px-4 pt-8">
              <h2 class="text-base font-bold text-tinta">Precio hora a hora de mañana</h2>
              <p class="mt-1 text-xs text-tenue">{fechaLarga(manana)} · PVPC sin impuestos</p>
              <div class="mt-3">
                <TablaHoras horas={datosManana!.horas} />
              </div>
            </section>

            <!-- Las tres más baratas -->
            <section class="px-4 pt-8">
              <h2 class="text-base font-bold text-tinta">Las tres horas más baratas de mañana</h2>
              <div class="mt-3 overflow-hidden rounded-2xl border border-borde bg-superficie">
                {baratas.map((h, i) => (
                  <div class="flex items-center justify-between gap-3 border-b border-borde px-4 py-3 last:border-0">
                    <div class="flex items-center gap-3">
                      <span class="mono w-5 text-sm font-bold text-tenue">{i + 1}</span>
                      <span class="mono text-sm font-semibold text-tinta">{tramo(h.hora, h.hora)}</span>
                    </div>
                    <span class="mono text-sm font-bold text-barato">{p5(h.precio)} €/kWh</span>
                  </div>
                ))}
              </div>
            </section>
          </>
        ) : (
          <section class="px-4 pt-6">
            <div class="rounded-2xl border border-aviso-borde bg-aviso p-4">
              <p class="text-sm font-semibold text-acento">Vuelve a partir de las 20:15h</p>
              <p class="mt-1.5 text-sm leading-relaxed text-suave">
                No es un fallo de la web: los precios de mañana no existen todavía. El mercado
                mayorista europeo casa la oferta y la demanda del día siguiente a mediodía y Red
                Eléctrica publica el resultado por la tarde. Cualquier web que te enseñe ahora
                mismo el precio de mañana se lo está inventando.
              </p>
            </div>

            <h2 class="mt-8 text-base font-bold text-tinta">Mientras tanto, el precio de hoy</h2>
            <p class="mt-1 text-xs text-tenue">{fechaLarga(hoy)} · PVPC sin impuestos</p>
            <div class="mt-3">
              <TablaHoras horas={datosHoy.horas} />
            </div>
          </section>
        )}

        <!-- A la app -->
        <section class="px-4 pt-8">
          <a href="/"
            class="flex items-center justify-between gap-3 rounded-2xl border border-borde bg-superficie px-4 py-3.5 transition-colors hover:border-acento">
            <div>
              <p class="text-sm font-semibold text-tinta">Míralo en directo y por zonas</p>
              <p class="text-xs text-suave">Con impuestos, por comunidad y con la hora actual marcada</p>
            </div>
            <span class="shrink-0 rounded-full bg-acento px-3 py-1.5 text-xs font-semibold text-sobre-acento">Abrir</span>
          </a>
        </section>

        <section class="px-4 pt-8">
          <h2 class="text-base font-bold text-tinta">Preguntas frecuentes</h2>
          <div class="mt-3 divide-y divide-borde">
            {faqs.map((f) => (
              <details class="group py-3">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium text-tinta">
                  <span>{f.q}</span>
                  <span class="text-acento transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-suave">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <footer class="px-4 pt-10 pb-8">
          <p class="text-xs leading-relaxed text-tenue">
            Precios del PVPC (Precio Voluntario para el Pequeño Consumidor) publicados por Red
            Eléctrica de España, sin impuestos y para la Península. Esta web es independiente: no
            es Red Eléctrica ni una comercializadora.
          </p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
            <a href="/" class="text-suave hover:text-acento">Inicio</a>
            <a href="/horas-baratas-hoy/" class="text-suave hover:text-acento">Horas baratas</a>
            <a href="/aviso-legal" class="text-suave hover:text-acento">Aviso legal</a>
            <a href="/privacidad" class="text-suave hover:text-acento">Privacidad</a>
          </div>
        </footer>
      </main>
    </div>
  </div>
</Layout>
