---
// Gráfica de línea/área para series temporales de precio (tendencia diaria, medias
// mensuales...). Un único trazo teal con relleno degradado, eje Y con 3 valores, eje X con
// unas pocas fechas repartidas, y un crosshair de ratón/tacto que sigue la curva sin
// necesidad de acertar sobre la línea de 2px. Datos ya calculados en el build (Astro),
// la única pieza de cliente es el hover: no hay framework, un <script> de una pantalla.
import { calcularGrafica } from '../lib/grafica.js';

interface Punto { fecha: string; valor: number; etiqueta: string }

interface Props {
  id: string; // único por instancia: puede haber más de una gráfica en la página
  serie: Punto[];
  unidad: string; // "cent/kWh"
  decimales?: number;
  ancho?: number;
  alto?: number;
  colorMinEsBueno?: boolean; // true: el mínimo se etiqueta en teal y el máximo en rojo
}

const {
  id, serie, unidad, decimales = 1, ancho = 640, alto = 220, colorMinEsBueno = true,
} = Astro.props;

const TEAL = '#2DD4BF';
const ROJO = '#F2545B';
const GRID = '#1D212B';
const MUTED = '#5A6070';
const TEXT = '#ECEAE3';

const fmt = (n: number) => (n * 100).toLocaleString('es-ES', { maximumFractionDigits: decimales });

const g = serie.length > 1
  ? calcularGrafica(serie, { ancho, alto })
  : null;

const iMin = serie.length ? serie.reduce((m, p, i) => (p.valor < serie[m].valor ? i : m), 0) : -1;
const iMax = serie.length ? serie.reduce((m, p, i) => (p.valor > serie[m].valor ? i : m), 0) : -1;

const colorExtremo = (esMin: boolean) => (colorMinEsBueno ? (esMin ? TEAL : ROJO) : (esMin ? ROJO : TEAL));

// Lo que necesita el script de hover: solo los puntos ya posicionados, nada de recalcular escalas.
const datosCliente = g
  ? { puntos: g.puntos.map((p) => ({ x: p.x, y: p.y, valor: p.valor, etiqueta: p.etiqueta })), baseY: g.baseY, areaTop: g.areaTop, decimales, unidad }
  : null;
---
{g && (
  <div class="grafica-linea" data-grafica-id={id}>
    <div class="relative">
      <svg viewBox={`0 0 ${ancho} ${alto}`} class="w-full" role="img"
        aria-label={`Evolución del precio, de ${fmt(g.ejeY[2].valor)} a ${fmt(g.ejeY[0].valor)} ${unidad}`}>
        <defs>
          <linearGradient id={`grad-${id}`} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color={TEAL} stop-opacity="0.22" />
            <stop offset="100%" stop-color={TEAL} stop-opacity="0" />
          </linearGradient>
        </defs>

        {/* Rejilla horizontal, recesiva: solo tres líneas, sin competir con la curva */}
        {g.ejeY.map((t) => (
          <line x1={g.escala.x0} y1={t.y} x2={g.escala.x1} y2={t.y} stroke={GRID} stroke-width="1" />
        ))}

        <path d={g.pathArea} fill={`url(#grad-${id})`} />
        <path d={g.pathLinea} fill="none" stroke={TEAL} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />

        {/* Etiqueta directa solo en el mínimo y el máximo: no un número en cada punto */}
        {iMin >= 0 && (
          <g>
            <circle cx={g.puntos[iMin].x} cy={g.puntos[iMin].y} r="4" fill={colorExtremo(true)} stroke="#0B0D12" stroke-width="2" />
          </g>
        )}
        {iMax >= 0 && iMax !== iMin && (
          <g>
            <circle cx={g.puntos[iMax].x} cy={g.puntos[iMax].y} r="4" fill={colorExtremo(false)} stroke="#0B0D12" stroke-width="2" />
          </g>
        )}

        {/* Eje Y: 3 valores de referencia */}
        {g.ejeY.map((t) => (
          <text x={g.escala.x0} y={t.y - 4} fill={MUTED} font-size="10" font-family="ui-monospace, monospace">{fmt(t.valor)}</text>
        ))}

        {/* Eje X: unas pocas fechas repartidas */}
        {g.ejeX.map((t) => (
          <text x={t.x} y={alto - 8} fill={MUTED} font-size="10" text-anchor="middle">{t.texto}</text>
        ))}

        {/* Capa de hover: línea vertical + punto, ocultos hasta que el script los active */}
        <g class="js-crosshair" style="opacity:0;pointer-events:none;">
          <line class="js-crosshair-line" x1="0" y1={g.areaTop} x2="0" y2={g.baseY} stroke={MUTED} stroke-width="1" stroke-dasharray="2,3" />
          <circle class="js-crosshair-dot" r="5" fill={TEAL} stroke="#0B0D12" stroke-width="2" />
        </g>

        {/* Área transparente que captura el puntero en todo el ancho del gráfico */}
        <rect class="js-hit" x={g.escala.x0} y={g.areaTop} width={g.escala.x1 - g.escala.x0} height={g.baseY - g.areaTop}
          fill="transparent" tabindex="0" style="cursor:crosshair;" aria-hidden="true" />
      </svg>

      <div class="js-tooltip pointer-events-none absolute hidden rounded-lg px-2.5 py-1.5 text-xs shadow-lg"
        style={`background-color:#1C202A;border:1px solid ${GRID};color:${TEXT};`}>
        <p class="js-tooltip-valor font-mono font-bold"></p>
        <p class="js-tooltip-fecha mt-0.5" style={`color:${MUTED};`}></p>
      </div>
    </div>

    <script type="application/json" class="js-datos" set:html={JSON.stringify(datosCliente)} />
  </div>
)}

<script>
  // Un crosshair por gráfica, sin dependencias. Nearest-point por X: el lector no tiene
  // que acertar sobre el trazo de 2px, solo pasar el ratón por la franja del gráfico.
  function iniciar(raiz: Element) {
    const script = raiz.querySelector('.js-datos');
    if (!script?.textContent) return;
    const datos = JSON.parse(script.textContent) as {
      puntos: { x: number; y: number; valor: number; etiqueta: string }[];
      baseY: number; areaTop: number; decimales: number; unidad: string;
    };
    const svg = raiz.querySelector('svg');
    const hit = raiz.querySelector('.js-hit') as SVGRectElement | null;
    const grupo = raiz.querySelector('.js-crosshair') as SVGGElement | null;
    const linea = raiz.querySelector('.js-crosshair-line') as SVGLineElement | null;
    const punto = raiz.querySelector('.js-crosshair-dot') as SVGCircleElement | null;
    const tooltip = raiz.querySelector('.js-tooltip') as HTMLElement | null;
    const tValor = raiz.querySelector('.js-tooltip-valor');
    const tFecha = raiz.querySelector('.js-tooltip-fecha');
    if (!svg || !hit || !grupo || !linea || !punto || !tooltip || !tValor || !tFecha) return;

    const fmt = (n: number) => (n * 100).toLocaleString('es-ES', { maximumFractionDigits: datos.decimales });

    function mas_cercano(xSvg: number) {
      let mejor = datos.puntos[0];
      let dist = Math.abs(mejor.x - xSvg);
      for (const p of datos.puntos) {
        const d = Math.abs(p.x - xSvg);
        if (d < dist) { mejor = p; dist = d; }
      }
      return mejor;
    }

    function mover(clientX: number, clientY: number) {
      const rect = svg!.getBoundingClientRect();
      const viewBox = svg!.viewBox.baseVal;
      const xSvg = ((clientX - rect.left) / rect.width) * viewBox.width;
      const p = mas_cercano(xSvg);

      linea!.setAttribute('x1', String(p.x));
      linea!.setAttribute('x2', String(p.x));
      punto!.setAttribute('cx', String(p.x));
      punto!.setAttribute('cy', String(p.y));
      grupo!.setAttribute('style', 'opacity:1;pointer-events:none;');

      (tValor as HTMLElement).textContent = `${fmt(p.valor)} ${datos.unidad}`;
      (tFecha as HTMLElement).textContent = p.etiqueta;

      // Posiciona el tooltip cerca del punto, en px reales, sin salirse del contenedor.
      const cont = raiz.querySelector('.relative') as HTMLElement;
      const contRect = cont.getBoundingClientRect();
      const pxX = (p.x / viewBox.width) * rect.width;
      const pxY = (p.y / viewBox.height) * rect.height;
      tooltip!.classList.remove('hidden');
      const anchoTip = tooltip!.offsetWidth || 90;
      let left = pxX + 10;
      if (left + anchoTip > contRect.width) left = pxX - anchoTip - 10;
      tooltip!.style.left = `${Math.max(0, left)}px`;
      tooltip!.style.top = `${Math.max(0, pxY - 38)}px`;
    }

    function ocultar() {
      grupo!.setAttribute('style', 'opacity:0;pointer-events:none;');
      tooltip!.classList.add('hidden');
    }

    hit.addEventListener('pointermove', (e) => mover(e.clientX, e.clientY));
    hit.addEventListener('pointerleave', ocultar);
    hit.addEventListener('pointerdown', (e) => mover(e.clientX, e.clientY));

    // Teclado: flechas izquierda/derecha recorren los puntos, con el mismo tooltip.
    let idx = Math.floor(datos.puntos.length / 2);
    hit.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      idx = Math.min(datos.puntos.length - 1, Math.max(0, idx + (e.key === 'ArrowRight' ? 1 : -1)));
      const p = datos.puntos[idx];
      const rect = svg!.getBoundingClientRect();
      const viewBox = svg!.viewBox.baseVal;
      mover(rect.left + (p.x / viewBox.width) * rect.width, rect.top);
    });
    hit.addEventListener('focus', () => {
      const p = datos.puntos[idx];
      const rect = svg!.getBoundingClientRect();
      const viewBox = svg!.viewBox.baseVal;
      mover(rect.left + (p.x / viewBox.width) * rect.width, rect.top);
    });
    hit.addEventListener('blur', ocultar);
  }

  document.querySelectorAll('.grafica-linea').forEach(iniciar);
</script>

<style>
  .grafica-linea .js-tooltip { min-width: 88px; z-index: 5; }
</style>
